{
  "name": "bb-plugin-workspace-sidebar",
  "version": "1.0.0",
  "description": "Groups BB's sidebar threads by project or status with pinned threads on top, subagents nested under their parent, statuses, snooze, undo, and back/forward thread history.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Ultra Sidebar",
    "description": "Groups BB's sidebar threads by project or status with pinned threads on top, subagents nested under their parent, statuses, snooze, undo, and back/forward thread history.",
    "branding": {
      "icon": "PanelLeft"
    },
    "server": "./src/server.ts",
    "app": "./src/app.tsx"
  },
  "files": [
    "src",
    "skills",
    "tsconfig.json",
    "GUIDE.md",
    "PLUGIN_OVERVIEW.md",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build": "bb plugin build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "cmdk": "^1.1.1",
    "saxes": "^6.0.0",
    "thinking-orbs": "^0.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dillionverma/bb-plugin-ultra-sidebar.git"
  },
  "homepage": "https://github.com/dillionverma/bb-plugin-ultra-sidebar#readme",
  "bugs": {
    "url": "https://github.com/dillionverma/bb-plugin-ultra-sidebar/issues"
  }
}
